# Vercel Deployment Environment Variables
# Set `LOCAL_MODE` to "false" when deploying to Vercel
LOCAL_MODE=true

# Database Configuration
# Use these for local development with SQLite
DATABASE_URL="file:./dev.db"

# Use these for Vercel Postgres
POSTGRES_PRISMA_URL="your_vercel_postgres_prisma_url"
POSTGRES_URL_NON_POOLING="your_vercel_postgres_non_pooling_url"

# AI Configuration
# Use this for local development with LocalAI
LOCAL_AI_URL="http://localhost:8080/v1/chat/completions"

# Use this for the Groq API
GROQ_API_KEY="your_groq_api_key"

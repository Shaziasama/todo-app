# Environment variables for Hugging Face Spaces deployment

# Use a mock LocalAI endpoint since Hugging Face Spaces won't run LocalAI by default
LOCALAI_BASE_URL="https://api.openai.com/v1"
LOCALAI_MODEL="gpt-3.5-turbo"
LOCALAI_TEMPERATURE="0.3"
LOCALAI_MAX_TOKENS="1024"

# NextAuth configuration
NEXTAUTH_SECRET="your-secret-here-changed-for-hf-spaces"
NEXTAUTH_URL="https://your-space-name.hf.space"

# Database (using SQLite which will work in Hugging Face Spaces)
DATABASE_URL="file:./dev.db"
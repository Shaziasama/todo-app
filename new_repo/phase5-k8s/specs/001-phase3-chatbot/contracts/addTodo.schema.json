{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evolution-of-todo.dev/schema/phase3/addTodo.schema.json",
  "title": "Add Todo Tool Payload",
  "type": "object",
  "required": ["title"],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": ["string", "null"],
      "maxLength": 1000
    }
  },
  "additionalProperties": false
}
